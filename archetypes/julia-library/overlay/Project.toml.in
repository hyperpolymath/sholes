# minted by: just repo-init julia-library ({{CURRENT_YEAR}})
# owner: {{OWNER}}
#
# uuid = "{{PACKAGE_UUID}}" is MINTED at mint as UUIDv8 profile C over the
# registered domain julia-package-identity, preimage
# github.com/<owner>/<name> (see repo-init's julia-library rule; the strict
# UUIDv8 gate rejects the v5 mint per ADR-008 D320). Profile C is
# deterministic, so the uuid is stable across re-mints of the same repo and
# never hand-edited. If the mint could not derive it (no python3 and no bun
# with standards' uuid-v8.js on the operator machine) it is UNASSIGNED and
# Pkg refuses to load the package until the owner assigns one.

name = "{{PROJECT_NAME}}"
uuid = "{{PACKAGE_UUID}}"
description = "{{PROJECT_DESCRIPTION}}"
authors = ["{{AUTHOR}} <{{AUTHOR_EMAIL}}"]
license = "MPL-2.0"
version = "0.1.0"

[deps]

# Test uuid = stdlib, resolved via Base.identify_package("Test") 2026-09-19
[extras]
Test = "8dfed614-e22c-5e08-85e1-65c5234f0b40"
Aqua = "4c88cf16-eb10-579e-8560-4a9242c79595"

# Aqua's deps_compat check requires a compat bound for EVERY extra —
# a template that omits these fails its own gate (measured 2026-09-19).
[targets]
test = ["Test", "Aqua"]

[compat]
julia = "1.9"
Test = "1.9"
Aqua = "0.8"
